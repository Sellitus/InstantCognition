# Bundled llama-server binaries (fetched via scripts/fetch-llama-server.js).
# Keep the directory structure (.gitkeep) but never commit the binaries themselves.
vendor/llama-server/*/*
!vendor/llama-server/*/.gitkeep

# Bundled MLX Python runtime (fetched via scripts/fetch-mlx-runtime.js).
# Same pattern — keep .gitkeep, skip the ~400MB interpreter + mlx_lm wheels.
vendor/mlx-python/*/*
!vendor/mlx-python/*/.gitkeep

# Bundled oMLX Python runtime (fetched via scripts/fetch-omlx-runtime.js).
vendor/omlx-python/*/*
!vendor/omlx-python/*/.gitkeep

# Bundled Moonshine ASR model (fetched via scripts/fetch-moonshine-model.js).
# Same pattern — keep .gitkeep, skip the ~120MB ONNX weights + generated manifest.
vendor/moonshine/*/*
!vendor/moonshine/*/.gitkeep

# Smoke-test models (downloaded by scripts/smoke-llm-engines.js). Never commit
# weights — they're reproducible from the harness on demand.
vendor/test-models/

# AI-assistant working state. These are one developer's scratch context, not
# project documentation: keeping them out of the repo stops stale internal notes
# from being read as current design.
CLAUDE.md
GEMINI.md
AGENTS.md
.claude/
.serena/
.meow-verify-ignore
openspec/

# Renderer bundles (scripts/build-renderer.js)
renderer.bundle.js
renderer.bundle.js.map
launcher.bundle.js
launcher.bundle.js.map
